# Copy to .env.local and add the SAME values in Vercel → Project → Settings → Environment Variables

# Gmail SMTP (use App Password, not regular password)
# Create at: Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=mountiesyouthbasketball@gmail.com
SMTP_APP_PASSWORD=your-16-character-gmail-app-password

# Where contact and booking form emails are sent
CONTACT_TO_EMAIL=tjandersty@gmail.com

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://mounties-youth-basketball-eight.vercel.app

# MongoDB Atlas — forms save here if email fails (or when SMTP is not set)
# Atlas → Database → Connect → Drivers → copy connection string
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.xxxxx.mongodb.net/mounties-youth-basketball?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB_NAME=mounties-youth-basketball

# Admin panel (required for /admin) — add these to Vercel too
ADMIN_PASSWORD=Mounties@Admin2026!
ADMIN_SESSION_SECRET=generate-a-long-random-secret-32chars-or-more
